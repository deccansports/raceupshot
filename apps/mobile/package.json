{
  "name": "@raceupshot/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean:artifacts": "find . -path './node_modules' -prune -o -name '._*' -type f -delete",
    "start": "npm run clean:artifacts && expo start",
    "start:clear": "npm run clean:artifacts && expo start --clear",
    "android": "npm run clean:artifacts && expo start --android",
    "ios": "npm run clean:artifacts && expo start --ios",
    "web": "npm run clean:artifacts && expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production"
  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@hookform/resolvers": "^5.4.0",
    "@race-technology/timing-calculations": "file:./race-technology-timing-calculations-0.1.0.tgz",
    "@raceupshot/live-tracking-contracts": "file:./raceupshot-live-tracking-contracts-0.1.0.tgz",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3"
  }
}
