{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@raceupshot/live-tracking-contracts": ["../../packages/live-tracking-contracts/src/index.ts"],
      "@raceupshot/live-tracking-contracts/*": ["../../packages/live-tracking-contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "legacy-raceupshot-20260826"]
}
