{
  "name": "race-upshot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:artifacts": "node scripts/clean-macos-artifacts.mjs",
    "clean:dev-cache": "node scripts/clean-next-dev-cache.mjs",
    "kv:sync:dev": "node scripts/sync-public-kv-to-dev.mjs",
    "dev": "npm run volunteer:web:export && npm run clean:artifacts && npm run clean:dev-cache && next dev --webpack --port 3001",
    "build": "npm run volunteer:web:export && npm run clean:artifacts && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "cf:build": "npm run volunteer:web:export && npm run clean:artifacts && next build --webpack && find .next -name '._*' -delete && opennextjs-cloudflare build --skipNextBuild && find .open-next -name '._*' -delete",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && wrangler deploy --autoconfig=false --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:clean-artifacts": "find apps/mobile -path 'apps/mobile/node_modules' -prune -o -name '._*' -type f -delete",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:start:clear": "npm --prefix apps/mobile run start:clear",
    "mobile:web": "npm --prefix apps/mobile run start:clear -- --web",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "volunteer:install": "npm --prefix apps/volunteer-mobile install",
    "volunteer:start": "npm --prefix apps/volunteer-mobile run start",
    "volunteer:start:clear": "npm --prefix apps/volunteer-mobile run start:clear",
    "volunteer:web": "npm --prefix apps/volunteer-mobile run web",
    "volunteer:web:clear": "npm --prefix apps/volunteer-mobile run web -- --clear",
    "volunteer:web:export": "cd apps/volunteer-mobile && ./node_modules/.bin/expo export --platform web --output-dir ../../public/volunteer-app",
    "volunteer:typecheck": "npm --prefix apps/volunteer-mobile run typecheck"
  },
  "dependencies": {
    "@bwip-js/generic": "^4.11.4",
    "@hookform/resolvers": "5.2.2",
    "@race-technology/rfid-core": "file:packages/rfid-core",
    "@race-technology/timing-calculations": "file:vendor/race-technology-timing-calculations-0.1.0.tgz",
    "@tanstack/react-query": "latest",
    "clsx": "latest",
    "expo": "^57.0.8",
    "expo-router": "57.0.8",
    "firebase": "^12.16.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.4",
    "jspdf": "^2.5.2",
    "juice": "^12.1.1",
    "lucide-react": "latest",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "read-excel-file": "^9.3.4",
    "recharts": "latest",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "latest",
    "xlsx": "^0.18.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-types": "latest",
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.149.0"
  }
}
