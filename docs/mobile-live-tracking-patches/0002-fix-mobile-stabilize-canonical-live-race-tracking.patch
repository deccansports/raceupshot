+/**
+ * Returns the closest coordinate on a published course polyline. Raw phone GPS
+ * commonly drifts several metres to either side of a road; athlete markers are
+ * course progress indicators and therefore must remain on the configured path.
+ */
+export function nearestPositionOnPath(
+  points: readonly LatLng[],
+  position: LatLng,
+): LatLng | undefined {
+  if (points.length === 0) return undefined;
+  if (points.length === 1) return points[0];
+
+  const latitudeScale = Math.max(
+    1e-6,
+    Math.cos(toRad(position.lat)),
+  );
+  let closest = points[0];
+  let closestDistanceSquared = Number.POSITIVE_INFINITY;
+
+  for (let index = 1; index < points.length; index += 1) {
+    const start = points[index - 1];
+    const end = points[index];
+    const startX = (start.lng - position.lng) * latitudeScale;
+    const startY = start.lat - position.lat;
+    const segmentX = (end.lng - start.lng) * latitudeScale;
+    const segmentY = end.lat - start.lat;
+    const segmentLengthSquared =
+      segmentX * segmentX + segmentY * segmentY;
+    const fraction =
+      segmentLengthSquared > 0
+        ? clamp01(
+            -(startX * segmentX + startY * segmentY) /
+              segmentLengthSquared,
+          )
+        : 0;
+    const projected = lerp(start, end, fraction);
+    const projectedX = (projected.lng - position.lng) * latitudeScale;
+    const projectedY = projected.lat - position.lat;
+    const distanceSquared =
+      projectedX * projectedX + projectedY * projectedY;
+    if (distanceSquared < closestDistanceSquared) {
+      closestDistanceSquared = distanceSquared;
+      closest = projected;
+    }
+  }
+
+  return closest;
+}
+
